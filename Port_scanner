@dataclass
class ScanResult:
    port: int
    service: str
    status: str  # "open" | "closed" | "filtered"
    banner: str = ""
    latency_ms: float = 0.0
    retried: bool = False


def validate_target(raw: str) -> tuple:
    """Validate and resolve a scan target.

    Returns ``(ip_address, display_name)``. Raises ValueError with a
    friendly, user-facing message for anything unusable.
    """
    target = (raw or "").strip()
    if not target:
        raise ValueError(
            "Enter a target first -- an IP address or hostname, e.g. 127.0.0.1"
        )
    if "/" in target:
        raise ValueError(
            "That looks like a network range (CIDR). This scanner does one "
            "host at a time -- enter a single IP address or hostname."
        )
    if " " in target:
        raise ValueError(
            "That target contains spaces -- enter a single IP address or hostname."
        )
    try:
        ip = socket.gethostbyname(target)
    except socket.gaierror:
        raise ValueError(
            f"Could not resolve '{target}'. Check the spelling, or use an IP address."
        ) from None
    except UnicodeError:
        raise ValueError(f"'{target}' is not a valid hostname or IP address.") from None
    return ip, target


def _grab_banner(sock: socket.socket, port: int) -> str:
    """Best-effort, passive banner read from an already-connected socket."""
    try:
        sock.settimeout(1.5)
        try:
            data = sock.recv(1024)
        except socket.timeout:
            if port in _HTTP_PORTS:
                sock.sendall(b"HEAD / HTTP/1.0\r\n\r\n")
                data = sock.recv(1024)
            else:
                return ""
        text = data.decode("utf-8", errors="replace").strip()
        # Keep the first meaningful line, trimmed for display.
        first = text.splitlines()[0].strip() if text else ""
        return first[:120]
    except OSError:
        return ""


def _connect_once(ip: str, port: int, timeout: float) -> tuple:
    """One connect attempt: (outcome, latency_ms, open_sock_or_None)."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    start = time.perf_counter()
    try:
        result = sock.connect_ex((ip, port))
        latency = (time.perf_counter() - start) * 1000.0
    except (socket.timeout, TimeoutError, OSError):
        sock.close()
        return "no-reply", (time.perf_counter() - start) * 1000.0, None
    if result == 0:
        return "open", latency, sock
    sock.close()
    if result == errno.ECONNREFUSED:
        return "closed", latency, None
    return "no-reply", latency, None


def scan_port(
    ip: str, port: int, timeout: float = 1.0, banner: bool = False
) -> ScanResult:
    """Connect-scan one port; classify it open / closed / filtered.

    A first-pass "no reply" is retried once at RETRY_TIMEOUT seconds
    before the port is called filtered.
    """
    service = SERVICE_NAMES.get(port, "unknown")
    outcome, latency, sock = _connect_once(ip, port, timeout)
    retried = False
    if outcome == "no-reply":
        retried = True
        outcome, latency, sock = _connect_once(ip, port, RETRY_TIMEOUT)
    try:
        if outcome == "open" and sock is not None:
            grabbed = _grab_banner(sock, port) if banner else ""
            return ScanResult(
                port=port, service=service, status="open", banner=grabbed,
                latency_ms=round(latency, 1), retried=retried,
            )
        status = "closed" if outcome == "closed" else "filtered"
        return ScanResult(
            port=port, service=service, status=status,
            latency_ms=round(latency, 1), retried=retried,
        )
    finally:
        if sock is not None:
            sock.close()


def scan_host(
    target: str,
    ports: Optional[Iterable[int]] = None,
    timeout: float = 1.0,
    banner: bool = False,
    workers: int = 32,
    profile: str = "quick",
) -> tuple:
    """Scan one host. Returns ``(ip, display_name, results sorted by port)``."""
    ip, display = validate_target(target)
    if ports is not None:
        port_list = sorted(set(ports))
    else:
        key = (profile or "quick").strip().lower()
        if key not in PROFILES:
            valid = ", ".join(sorted(PROFILES))
            raise ValueError(f"Unknown profile '{profile}'. Choose one of: {valid}.")
        port_list = list(PROFILES[key])
    results: List[ScanResult] = []

    def _job(p: int) -> ScanResult:
        return scan_port(ip, p, timeout=timeout, banner=banner)

    with ThreadPoolExecutor(max_workers=max(1, workers)) as pool:
        futures = {pool.submit(_job, p): p for p in port_list}
        for future in as_completed(futures):
            try:
                results.append(future.result())
            except Exception:
                continue
    results.sort(key=lambda r: r.port)
    return ip, display, results


_USAGE = (
    "Usage: port_scanner [target] [--banner] [--timeout SECONDS] "
    "[--profile quick|standard|deep]"
)


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    banner = "--banner" in argv
    argv = [a for a in argv if a != "--banner"]
    timeout = 1.0
    if "--timeout" in argv:
        idx = argv.index("--timeout")
        try:
            timeout = float(argv[idx + 1])
            del argv[idx : idx + 2]
        except (IndexError, ValueError):
            print(_USAGE)
            return 2
    profile = "quick"
    if "--profile" in argv:
        idx = argv.index("--profile")
        try:
            profile = argv[idx + 1]
            del argv[idx : idx + 2]
        except IndexError:
            print(_USAGE)
            return 2
    if any(a.startswith("--") for a in argv) or len(argv) > 1:
        print(_USAGE)
        return 2

    print("QuantumCat port scanner -- a learning tool for your own machines.")
    print(f"[!] {AUTHORIZED_USE_NOTE}")

    target = argv[0] if argv else ""
    if not target:
        try:
            target = input("\nEnter target IP or hostname: ")
        except (EOFError, KeyboardInterrupt):
            print("\nNo target given -- nothing to scan.")
            return 1

    started = time.perf_counter()
    try:
        ip, display, results = scan_host(
            target, timeout=timeout, banner=banner, profile=profile)
    except ValueError as exc:
        print(f"\n[!] {exc}")
        return 1
    duration = time.perf_counter() - started

    shown = display if display == ip else f"{display} ({ip})"
    print(f"\n[+] Scanning {shown} -- {len(results)} ports "
          f"(profile: {profile})\n")

    counts = {"open": 0, "closed": 0, "filtered": 0}
    for r in results:
        counts[r.status] += 1
        timing = f"({r.latency_ms:.0f} ms" + (", after retry)" if r.retried else ")")
        if r.status == "open":
            line = f"[OPEN]     Port {r.port:<5} {r.service}  {timing}"
            if r.banner:
                line += f"  -- {r.banner}"
            print(line)
            if r.port in RISKY_REASONS:
                print(f"           [!] Risky if exposed: {RISKY_REASONS[r.port]}")
        else:
            print(f"[{r.status.upper():<8}] Port {r.port:<5} {r.service}  {timing}")

    print(
        f"\n[+] Scan complete in {duration:.1f}s: {counts['open']} open, "
        f"{counts['closed']} closed, {counts['filtered']} filtered."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
